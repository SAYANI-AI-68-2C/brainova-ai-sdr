# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/brainova_ai_sdr

# OpenAI / LLM API Key (For AI SDR Reasoning, NLP & Outreach Generation)
OPENAI_API_KEY=your_openai_api_key_here

# Algorand Testnet Node Configuration (x402 Protocol)
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=

# Agent Recipient Algorand Wallet (Where x402 micropayments are collected)
AGENT_ALGORAND_WALLET_ADDRESS=YOUR_ALGORAND_TESTNET_PUBLIC_KEY
AGENT_WALLET_MNEMONIC="twenty five word mnemonic phrase here if automated settlement is enabled"

# x402 Pricing Tiers (in microAlgos - 1 ALGO = 1,000,000 microAlgos)
X402_LEAD_ENRICHMENT_PRICE=500000       # 0.5 ALGO
X402_QUALIFIED_LEAD_PRICE=1000000       # 1.0 ALGO
X402_FULL_PIPELINE_RUN_PRICE=2000000    # 2.0 ALGO
